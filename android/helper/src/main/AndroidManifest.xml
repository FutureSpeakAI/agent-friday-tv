<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately NO android.permission.INTERNET (or any network permission). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Required by Android for Visualizer on the output mix (session 0): reads the TV's own
         sound LEVEL for the audio fallback. The app never opens the microphone (no AudioRecord). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- To list installed TV apps in Settings (package visibility; not a network permission). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- launch(pkg) for Agent Friday also accepts apps with only a phone-style launcher entry. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Google Cast receiver: Ad Break Guard binds it so Android doesn't freeze it (see CastKeepAlive). -->
        <package android:name="com.google.android.apps.mediashell" />
    </queries>

    <!-- The shared grown-up PIN: only apps signed with the same key (Agent Friday) may ask. -->
    <permission
        android:name="org.tvprivacy.adbreak.permission.GROWN_UP"
        android:label="Check the grown-up PIN"
        android:protectionLevel="signature" />
    <uses-permission android:name="org.tvprivacy.adbreak.permission.GROWN_UP" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".KidsHomeActivity" android:exported="false" android:launchMode="singleTask" android:excludeFromRecents="true" />
        <activity android:name=".TimeUpActivity" android:exported="false" android:launchMode="singleTask" android:excludeFromRecents="true" />
        <activity android:name=".PinActivity" android:exported="false" android:excludeFromRecents="true" />
        <activity android:name=".BedtimeActivity" android:exported="false" android:launchMode="singleTask" android:excludeFromRecents="true" />
        <activity android:name=".KidsSettingsActivity" android:exported="false" android:excludeFromRecents="true" />
        <!-- Kids slice 1: Friday's kids home "Grown-up" button. Signature-protected; always the
             "leave kids mode" PIN pad (PinActivity ignores every extra when started this way). -->
        <activity-alias
            android:name=".KidsGrownUp"
            android:targetActivity=".PinActivity"
            android:exported="true"
            android:permission="org.tvprivacy.adbreak.permission.GROWN_UP">
            <intent-filter>
                <action android:name="org.tvprivacy.adbreak.action.KIDS_GROWN_UP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name=".GrownUpProvider"
            android:authorities="org.tvprivacy.adbreak.grownup"
            android:exported="true"
            android:permission="org.tvprivacy.adbreak.permission.GROWN_UP"
            android:grantUriPermissions="false" />

        <service android:name=".FsDreamService" android:exported="true" android:label="FutureSpeak" android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter><action android:name="android.service.dreams.DreamService" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </service>

        <service
            android:name=".AdGuardService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/adguard_service" />
        </service>
    </application>
</manifest>
